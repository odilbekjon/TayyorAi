# BotFather bergan token
BOT_TOKEN=
# Google AI Studio'dan bepul kalit: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Bepul tarifda ishlaydigan model
GEMINI_MODEL=gemini-3.8-flash
# MongoDB Atlas (bepul M0) ulanish manzili
MONGODB_URI=mongodb://127.0.0.1:27017/tayyorai
# Ixtiyoriy: slayd rasmlari uchun bepul Pexels kaliti https://www.pexels.com/api/
PEXELS_API_KEY=
# Ixtiyoriy: bepul Pixabay kaliti https://pixabay.com/api/docs/ (kalitsiz ham Openverse va Wikimedia ishlaydi)
PIXABAY_API_KEY=
# Yangi foydalanuvchiga beriladigan bepul kredit (20 = 2 ta slayd)
FREE_CREDITS=20
# Oylik obuna: narxi (so'm), beriladigan kredit va muddati (kun)
SUBSCRIPTION_PRICE=10000
SUBSCRIPTION_CREDITS=100
SUBSCRIPTION_DAYS=30
# To'lov qabul qilinadigan karta (faqat serverda saqlang, repoga yozmang)
PAYMENT_CARD=
PAYMENT_CARD_HOLDER=
# Admin Telegram ID'lari, vergul bilan (kredit qo'shish uchun)
ADMIN_IDS=
# Ixtiyoriy: Chromium yo'li (odatda kerak emas, "npx playwright install chromium" yetarli)
CHROMIUM_PATH=
