{
  "name": "tayyorai",
  "version": "0.1.0",
  "description": "TayyorAI: slayd, rezyume, hujjat va boshqa ishlarni tayyorlab beradigan Telegram bot",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "demo:slides": "tsx scripts/demo-slides.ts",
    "demo:docs": "tsx scripts/demo-docs.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "docx": "^9.11.0",
    "exceljs": "^4.4.0",
    "grammy": "^1.46.0",
    "mongoose": "^9.11.2",
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
